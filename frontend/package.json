{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:performance": "PERF_USE_BACKEND=1 playwright test tests/e2e/performance.spec.ts",
    "test:performance:backend": "PERF_USE_BACKEND=1 playwright test tests/e2e/performance.spec.ts",
    "test:performance:desktop": "PERF_USE_BACKEND=1 playwright test tests/e2e/performance.spec.ts --project=desktop-chromium",
    "test:performance:mobile": "PERF_USE_BACKEND=1 playwright test tests/e2e/performance.spec.ts --project='mobile-*'",
    "test:performance:mocked": "playwright test tests/e2e/performance.spec.ts",
    "test:performance:diagnostics": "PERF_USE_BACKEND=1 PERF_DIAGNOSTICS=1 playwright test tests/e2e/performance.spec.ts",
    "playwright:install": "playwright install chromium webkit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "echarts": "^6.1.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "web-vitals": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/stats.js": "^0.17.4",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "react-scan": "^0.5.7",
    "stats.js": "^0.17.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.0.0"
  }
}
